# Website (Nuxt) settings. On Vercel, add these under Project -> Settings -> Environment Variables.

# Where the FastAPI backend lives (the website forwards /api/* there)
NUXT_API_ORIGIN=http://127.0.0.1:8000

# Shared secret so the API trusts the visitor IP the website forwards (rate limiting).
# Use the same value as PROXY_SHARED_SECRET on the API. Generate: openssl rand -hex 32
NUXT_PROXY_SECRET=
