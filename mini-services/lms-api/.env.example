# LearnHub LMS API configuration
# Copy to .env and adjust as needed. Every value has a sane default.

# Any SQLAlchemy database URL. Use sqlite for local dev,
# e.g. postgresql+psycopg://user:pass@host:5432/lms for production.
LMS_DATABASE_URL=sqlite:///./data/lms.db

# Set a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
