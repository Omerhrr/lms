# Infohive LMS API configuration. Copy to .env for local use; on Vercel add these as
# Environment Variables of the API project. Every value has a safe local default.

# "production" on Vercel: refuses to start without SECRET_KEY and turns on Secure cookies
ENV=development

# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# ---------- database ----------
# Local: SQLite. Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543), e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
LMS_DATABASE_URL=sqlite:///./data/lms.db
AUTO_MIGRATE=true

# Public URL of the website (links in emails, Paystack return URL)
FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call the API directly (the website proxies /api, so usually just the site)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Same value as NUXT_PROXY_SECRET on the website (lets the API see real visitor IPs)
PROXY_SHARED_SECRET=

# ---------- sessions ----------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
# COOKIE_SECURE defaults to true when ENV=production
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------- email (SMTP) ----------
# Empty SMTP_HOST = emails are printed to the API log instead of sent.
# Gmail: smtp.gmail.com / 587 / starttls / your address / an App Password
# Zoho: smtp.zoho.com / 465 / ssl     Brevo: smtp-relay.brevo.com / 587 / starttls
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LearnHub <no-reply@yourdomain.com>

# ---------- payments (Paystack) - OFF by default ----------
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CURRENCY=NGN
# When payments are off, paid courses need manual enrollment by the instructor/admin
ALLOW_UNPAID_ENROLLMENT=false

# ---------- live classes ----------
# Built-in video rooms use Jitsi. For real classes create a free JaaS account (jaas.8x8.vc), add an
# API key, and paste: App ID, Key ID and the private key (PEM; \n line breaks are fine).
# Without JaaS, rooms open on JITSI_DOMAIN - the public meet.jit.si cuts embedded calls after ~5 min.
JITSI_DOMAIN=meet.jit.si
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=
LIVE_JOIN_EARLY_MINUTES=15

# ---------- website contact details (shown on the site when filled in) ----------
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_HOURS=
SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_X=
# where contact-form enquiries are emailed (defaults to CONTACT_EMAIL)
ENQUIRY_NOTIFY_EMAIL=

# ---------- file uploads ----------
# Local disk by default. On Vercel you MUST use Supabase Storage (create a PUBLIC bucket first):
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=lms-media
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
